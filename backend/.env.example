SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres:password@aws-0-region.pooler.supabase.com:5432/postgres
# Session pooler (port 5432), not db.<project>.supabase.co — that host is IPv6-only and
# unreachable from Render, so startup migrations fail there.
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-5

SUPABASE_STORAGE_BUCKET=ipp-templates

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
